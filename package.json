{
  "name": "digital-banking-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Banking System with NIBSS Integration - Clean Hexagonal Architecture",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm build:backend && pnpm build:frontend",
